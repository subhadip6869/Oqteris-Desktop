[Desktop Entry]
Name=Oqteris
GenericName=PDF Reader and Editor
Comment=Professional cross-platform desktop PDF reader and editor
Exec=oqteris %U
Icon=app.vercel.originsd.oqteris
Terminal=false
Type=Application
Categories=Office;Viewer;Graphics;Publishing;
MimeType=application/pdf;application/x-pdf;
StartupNotify=true
StartupWMClass=app.vercel.originsd.oqteris
Keywords=pdf;reader;editor;viewer;annotate;sign;ocr;
Actions=NewWindow;

[Desktop Action NewWindow]
Name=Open a New Window
Exec=oqteris
